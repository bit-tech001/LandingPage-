# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: Gemini model id for lead generation.
# Defaults to gemini-3.5-flash (gemini-2.0-flash/2.5-flash are retired → 404;
# gemini-3.8-flash may return 503 when demand spikes).
GEMINI_MODEL="gemini-3.5-flash"

# GEMINI_MAX_COMBOS / GEMINI_CONCURRENCY: Caps on city×industry combos per
# Gemini sweep (default 24) and parallel calls (default 4) so harvest sweeps
# finish in ~1 minute instead of firing 130+ sequential requests.
GEMINI_MAX_COMBOS=24
GEMINI_CONCURRENCY=4


# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ---------------------------------------------------------------------------
# Dodo Payments (payment provider — hosted checkout, merchant of record)
# ---------------------------------------------------------------------------
# Create products in the Dodo dashboard (https://app.dodopayments.com → Products)
# for each paid plan, then paste the product IDs below. Get the secret API key
# from Developer → API Keys (write access).
#
# - If DODO_PAYMENTS_API_KEY + product IDs are set, Pay Now opens the Dodo
#   hosted checkout (UPI, cards, etc). After payment the customer returns to
#   the app and credits are granted (webhook + return-url verification).
# - Register the webhook in Dodo: {APP_URL}/api/payment/dodo/webhook
#   and set DODO_WEBHOOK_SECRET to the signing secret (whsec_...) for
#   signature verification. Without the secret, webhooks are accepted unsigned.
# - DODO_PAYMENTS_MODE=test uses https://test.dodopayments.com instead of live.
# - If no keys are set, the app runs in SANDBOX mode and completes payments
#   locally so the product remains fully usable for demos.
DODO_PAYMENTS_API_KEY=""
DODO_PAYMENTS_MODE="live"
DODO_PRODUCT_ID_STARTER=""
DODO_PRODUCT_ID_PRO=""
DODO_PRODUCT_ID_AGENCY=""
DODO_WEBHOOK_SECRET=""

# ---------------------------------------------------------------------------
# Live Lead Sources
# ---------------------------------------------------------------------------
# GOOGLE_PLACES_API_KEY: Enables real Google Maps listings (Places API New,
# Text Search) in addition to the always-on OpenStreetMap source.
# Get a key from https://console.cloud.google.com/apis/credentials and enable
# "Places API (New)". The $200/month Google credit covers tens of thousands
# of demo searches.
# Without a key the app still fetches real leads from OpenStreetMap only.
GOOGLE_PLACES_API_KEY=""

# ---------------------------------------------------------------------------
# AI Lead Scraper (LangGraph daily workflow)
# ---------------------------------------------------------------------------
# GOOGLE_MAPS_API_KEY: alias for GOOGLE_PLACES_API_KEY (either name works).
GOOGLE_MAPS_API_KEY=""
# OPENAI_API_KEY: enables AI lead classification (industry, service needs,
# 1-100 score, priority). Without it the scraper still runs and classifies
# leads with deterministic rules instead of the LLM.
OPENAI_API_KEY=""
# Optional overrides:
SCRAPER_OPENAI_MODEL="gpt-4o-mini"
SCRAPER_DAILY_LIMIT=50
SCRAPER_TIMEZONE="Asia/Kolkata"
SCRAPER_CRON="0 8 * * *"

# Port for the Express payment/API server (server.js)
PORT=3001

# ---------------------------------------------------------------------------
# Clerk.com authentication (Google OAuth + email/password)
# ---------------------------------------------------------------------------
# Create an application at https://dashboard.clerk.com → "+ Add application",
# then copy both keys here (never commit real secrets):
#   VITE_CLERK_PUBLISHABLE_KEY  pk_test_… / pk_live_…  (frontend, safe to expose)
#   CLERK_SECRET_KEY            sk_test_… / sk_live_…  (backend token verification)
#
# Clerk dashboard checklist (do these in dashboard.clerk.com):
#   1. User & Authentication → Social connections → enable Google.
#   2. Paths → Application:
#        Fallback development host: http://localhost:3000
#        Home URL: (blank)
#        Unauthorized sign in URL: /unauthorized-sign-in
#   3. Paths → Component paths (development host column — NOT Account Portal):
#        <SignIn />: /sign-in
#        <SignUp />:  /sign-up
#        Signing Out: /
#        OAuth consent: /
#        OAuth device verification: /
#      Code also sets these in App.tsx (signInUrl/signUpUrl/afterSignOutUrl).
#   4. Paths → Redirect URLs — add ALL of:
#        http://localhost:3000/
#        http://localhost:3000/sso-callback
#      (Production: replace localhost with your real domain.)
#   5. Optional: User & Authentication → Email, phone, username →
#      enable Email code (for sign-up verification in the custom UI).
#   6. Restart `npm run server` so the backend picks up CLERK_SECRET_KEY.
#   7. Restart `npm run dev` so Vite picks up VITE_CLERK_PUBLISHABLE_KEY.
#
# Without keys the app runs in DEMO mode (local accounts only).
VITE_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""

# ---------------------------------------------------------------------------
# Super Admin (owner) account
# ---------------------------------------------------------------------------
# This email always receives the admin role and can open the Admin Portal.
# SUPER_ADMIN_EMAIL is enforced by the API; VITE_SUPER_ADMIN_EMAIL is used by
# the frontend to show the Portal link (keep both values identical).
SUPER_ADMIN_EMAIL="bp2817433@gmail.com"
VITE_SUPER_ADMIN_EMAIL="bp2817433@gmail.com"

# ---------------------------------------------------------------------------
# Database (Neon Postgres)
# ---------------------------------------------------------------------------
# Paste your Neon pooled connection string (postgres://user:pass@host/db?sslmode=require)
# from https://console.neon.tech
#
# - If DATABASE_URL is set and `npm run server` is running, accounts, sessions,
#   subscriptions, credit transactions, unlocks, saved leads, and lists are all
#   persisted to Postgres (tables are created automatically on first boot).
# - If empty, the app falls back to localStorage so it remains fully usable
#   without a database.
DATABASE_URL=""

# ---------------------------------------------------------------------------
# Lead engine background worker (optional)
# ---------------------------------------------------------------------------
# REDIS_URL: When set, the multi-source lead engine uses BullMQ + Redis and
# runs a discovery job every 7 minutes (target: 1,000+ new prospects/day at
# production scale). When empty, an in-process timer runs the same cycle
# every 5–10 minutes without Redis.
# Example: redis://localhost:6379
REDIS_URL=""

# ---------------------------------------------------------------------------
# Foursquare Places API (New) � free-tier lead source
# ---------------------------------------------------------------------------
# Official docs: https://docs.foursquare.com/fsq-developers-places/reference/place-search
# Get a free Service Key from https://foursquare.com/developers (Developer Console
# -> Service Keys). Sandbox/PAYG keys get 50 QPS � far more than this app uses.
# The source runs Place Search (ll + radius, tel_format=E164) per city/industry
# and degrades to core fields automatically if a field is plan-gated.
# Without a key the app still fetches real leads from Overpass/OSM (always on),
# Google Places (if keyed) and the local master store.
FOURSQUARE_API_KEY=""

# ---------------------------------------------------------------------------
# Hunter API � public business email enrichment
# ---------------------------------------------------------------------------
# Official docs: https://www.hunter.io/api-documentation/v2
# Get a free API key from https://hunter.io/users/sign_up?from=api
# Domain Search resolves a lead's website domain to a public email address
# (confidence + verification status attached to the lead). The free plan has a
# small monthly search quota � the built-in budget guards keep it safe:
#   HUNTER_MONTHLY_SEARCH_LIMIT  local ledger ceiling (free plan = 25 searches)
#   HUNTER_DAILY_CALLS           max paid calls per day (spreads the quota)
#   HUNTER_CALLS_PER_CYCLE       max paid calls per discovery cycle / search
# The free Domain Finder endpoint (name -> domain) is used first when a lead
# has no website. On 429/403 the module backs off automatically.
HUNTER_API_KEY=""
HUNTER_MONTHLY_SEARCH_LIMIT=25
HUNTER_DAILY_CALLS=5
HUNTER_CALLS_PER_CYCLE=5

# ---------------------------------------------------------------------------
# Daily lead floor � 350+ NEW unique leads per day (hard guarantee)
# ---------------------------------------------------------------------------
# While today's insert count is below this floor the engine runs 2-4 min
# chase cycles with widened plans (tier-2 cities + more industries) and queues
# a BullMQ follow-up; once met it relaxes back to the normal 5-10 min cadence.
DAILY_MIN_NEW_LEADS=350

# ---------------------------------------------------------------------------
# Consent, opt-out & outreach-compliance controls
# ---------------------------------------------------------------------------
# Suppression (opt-out/DNC), the consent ledger and the outreach log live in
# server/data/compliance.json � file-backed so opt-outs survive without Postgres.
#
# COMPLIANCE_MODE:
#   standard (default) - email/sms/whatsapp require recorded consent; calls to
#                        publicly listed business numbers are allowed under
#                        legitimate interest (quiet hours + cooldown still apply)
#   strict             - every channel requires an explicit "granted" consent
# COMPLIANCE_REQUIRE_CONSENT: true/false overrides the mode's consent rule.
COMPLIANCE_MODE="standard"
COMPLIANCE_REQUIRE_CONSENT=""
COMPLIANCE_TZ="Asia/Kolkata"
COMPLIANCE_QUIET_HOURS_START=9
COMPLIANCE_QUIET_HOURS_END=20
COMPLIANCE_COOLDOWN_DAYS=7
COMPLIANCE_DAILY_CONTACT_LIMIT=500
