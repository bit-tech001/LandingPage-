# ---------------------------------------------------------------------------
# Environment files — NEVER commit these (they hold API keys and secrets).
# Keep the templates so collaborators know which variables to set.
# ---------------------------------------------------------------------------
.env
.env.*
.envrc
!.env.example
!.env.sample
!.env.template
.dev.vars
.dev.vars.*
!.dev.vars.example

